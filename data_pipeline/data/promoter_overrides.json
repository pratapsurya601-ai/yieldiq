  "_schema": {
    "version": 1,
    "description": "Manual promoter-holding overrides for Indian equities where the NSE share-holding-pattern feed under-reports or mis-categorises the economic promoter. Foreign promoters frequently appear under 'Public' or 'FPI' on Indian filings (BAT in ITC, Unilever in HUL, Suzuki in MARUTI, etc.). RBI norms forbid a designated promoter for private banks, so those are flagged 'no_promoter_bank' rather than '0.0% — Low stake'. Values verified against the most recent BSE/NSE share-holding-pattern.htm at time of seeding; refresh quarterly.",
    "types": {
      "foreign_promoter": "Economic promoter is a foreign parent; pct is its effective beneficial holding.",
      "no_promoter_bank": "RBI norms — no designated promoter (private commercial bank). pct is null.",
      "govt_promoter": "Government of India (directly or via LIC/SUUTI/specified-undertakings) acts as the economic promoter; pct is aggregate GOI + LIC holding.",
      "domestic_promoter": "Standard domestic promoter; override exists only because the extractor misreads the filing."
    }
  },
